<!--            <artifactId>jline-terminal-jna</artifactId>-->
<!--            <version>${dep.jline.version}</version>-->
<!--            <scope>runtime</scope>-->
<!--        </dependency>-->
    </dependencies>

    <build>
        <finalName>opencga-enterprise-app</finalName>
        <sourceDirectory>src/main/java</sourceDirectory>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>enterprise-cli-usage.yml</include>
                </includes>
                <targetPath>${project.basedir}/target/classes</targetPath>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>appassembler-maven-plugin</artifactId>
                <version>1.10</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>assemble</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <repositoryName>libs</repositoryName>
                    <repositoryLayout>flat</repositoryLayout>
                    <useWildcardClassPath>false</useWildcardClassPath>
                    <!--By default, "etc".-->
                    <configurationDirectory>conf</configurationDirectory>
                    <!--Do we need to include the configuration folder in the classpath?-->
                    <includeConfigurationDirectoryInClasspath>false</includeConfigurationDirectoryInClasspath>
                    <environmentSetupFileName>../conf/${opencga.env.file}</environmentSetupFileName>
                    <programs>
                        <program>
                            <id>opencga.sh</id>
                            <mainClass>com.zettagenomics.opencga.enterprise.app.cli.main.OpencgaEnterpriseMain</mainClass>
                            <platforms>
                                <platform>unix</platform>
                            </platforms>
                        </program>
                        <program>
                            <id>opencga-admin.sh</id>
                            <mainClass>com.zettagenomics.opencga.enterprise.app.cli.admin.AdminMain</mainClass>
                            <platforms>
                                <platform>unix</platform>
                            </platforms>
                        </program>
                        <program>
                            <id>opencga-internal.sh</id>
                            <mainClass>org.opencb.opencga.app.cli.internal.InternalMain</mainClass>
                            <platforms>
                                <platform>unix</platform>
                            </platforms>
                        </program>
                        <program>
                            <id>opencga-clicompletion.sh</id>
                            <mainClass>org.opencb.opencga.app.cli.utils.CliCompletionMain</mainClass>
                            <platforms>
                                <platform>unix</platform>
                            </platforms>
                        </program>
                        <program>
                            <id>opencga-storage-hadoop.sh</id>
                            <mainClass>org.opencb.opencga.storage.hadoop.app.Main</mainClass>
                            <platforms>
                                <platform>unix</platform>
                            </platforms>
                        </program>
                    </programs>
                </configuration>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-libs</id>
                        <phase>clean</phase>
                        <configuration>
                            <target>
                                <echo>Preparing ${build.dir} folder</echo>
                                <exec executable="rm">
                                    <arg value="-rf"/>
                                    <arg value="${build.dir}"/>
                                </exec>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>install-app</id>
                        <phase>install</phase>
                        <configuration>
                            <target>
                                <echo>Preparing ${build.dir} folder</echo>
                                <echo>=============================</echo>
                                <echo>Deleting ${build.dir} folder</echo>
                                <exec executable="rm">
                                    <arg value="-rf"/>
                                    <arg value="${build.dir}"/>
                                </exec>

                                <echo>Creating all folders in ${build.dir}</echo>
                                <exec executable="mkdir">
                                    <arg value="-p"/>
                                    <arg value="${build.dir}/clients"/>
                                    <arg value="${build.dir}/cloud/docker/opencga-enterprise"/>
                                    <arg value="${build.dir}/conf"/>
                                </exec>

                                <echo>Copying OpenCGA files and folders to ${build.dir}</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${opencga.build.dir}/analysis"/>
                                    <arg value="${opencga.build.dir}/cloud"/>
                                    <arg value="${opencga.build.dir}/conf"/>
                                    <arg value="${opencga.build.dir}/misc"/>
                                    <arg value="${build.dir}"/>
                                </exec>

                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${opencga.build.dir}/cloud/docker/docker-build.py"/>
                                    <arg value="${opencga.build.dir}/cloud/docker/README.md"/>
                                    <arg value="${build.dir}/cloud/docker"/>
                                </exec>

                                <echo>Update OpenCGA Enterprise configuration.yml analysis, adding com.zettagenomics.opencga.enterprise package</echo>
                                <exec executable="sed">
                                    <arg value='s/- "org.opencb.opencga"/- "org.opencb.opencga"\n    - "com.zettagenomics.opencga.enterprise"/'/>
                                    <arg value="${build.dir}/conf/configuration.yml"/>
                                    <arg value="-i"/>
                                </exec>

                                <echo>Copying OpenCGA Enterprise bin and libs folder to ${build.dir}</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${project.basedir}/target/appassembler/bin"/>
                                    <arg value="${project.basedir}/target/appassembler/libs"/>
                                    <arg value="${app.dir}/cloud/docker/.dockerignore"/>
                                    <arg value="${build.dir}"/>
                                </exec>

                                <echo>Copying Docker files to ${build.dir}/cloud/docker/opencga-enterprise</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${app.dir}/cloud/docker/opencga-enterprise"/>
                                    <arg value="${app.dir}/cloud/docker/.dockerignore"/>
                                    <arg value="${build.dir}/cloud/docker/"/>
                                </exec>

                                <echo>Copying SSO to ${build.dir}/cloud</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${app.dir}/cloud/sso"/>
                                    <arg value="${build.dir}/cloud/"/>
                                </exec>

                                <exec executable="${project.basedir}/app/cvdb/prepare_configsets.sh">
                                    <arg value="${project.basedir}/.."/>
                                    <arg value="${project.parent.version}"/>
                                </exec>

                                <echo>Copying git.properties</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="${project.basedir}/../opencga-enterprise-core/target/generated-resources/com/zettagenomics/opencga/enterprise/git-enterprise.properties"/>
                                    <arg value="${build.dir}/misc/git"/>
                                </exec>

                                <echo>Copying Python, R and JavaScript to ${build.dir}/clients</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${project.basedir}/../opencga-enterprise-client/src/main/python"/>
                                    <arg value="${build.dir}/clients"/>
                                </exec>

                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${project.basedir}/../opencga-enterprise-client/src/main/R"/>
                                    <arg value="${build.dir}/clients"/>
                                </exec>
                                <!-- We need to read DESCRIPTION from target folder because we have renamed the version -->
<!--                                <exec executable="cp">-->
<!--                                    <arg value="${project.basedir}/../opencga-enterprise-client/target/classes/DESCRIPTION"/>-->
<!--                                    <arg value="${build.dir}/clients/R/"/>-->
<!--                                </exec>-->
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${project.basedir}/../opencga-enterprise-client/src/main/javascript"/>
                                    <arg value="${build.dir}/clients"/>
                                </exec>

                                <echo>Copying configuration files</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="${project.basedir}/../opencga-enterprise-core/target/classes/enterprise-configuration.yml"/>
                                    <arg value="${build.dir}/conf"/>
                                </exec>

                                <echo>Copying war file</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="${project.basedir}/../opencga-enterprise-server/target/${opencga.war.name}.war"/>
                                    <arg value="${build.dir}"/>
                                </exec>

                                <echo>Copying hadoop jar with dependencies to ${build.dir}</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="${opencga.build.dir}/opencga-storage-hadoop-lib-${opencga-hadoop-shaded.id}-${opencga.version}-jar-with-dependencies.jar"/>
                                    <arg value="${build.dir}"/>
                                </exec>
                                <exec executable="cp" failonerror="true">
                                    <arg value="${project.basedir}/target/appassembler/bin/opencga-storage-hadoop.sh"/>
                                    <arg value="${build.dir}/misc/scripts/"/>
                                </exec>
                                <!-- We need to modify the BASEDIR to one level up, as this script will be at a sub folder-->
                                <exec executable="sed" failonerror="true">
                                    <arg value="-i"/>
                                    <arg value='s/BASEDIR=`cd "$PRGDIR\/.."/BASEDIR=`cd "$PRGDIR\/..\/.."/g'/>
                                    <arg value="${build.dir}/misc/scripts/opencga-storage-hadoop.sh"/>
                                </exec>
                                <exec executable="bash" failonerror="true">
                                    <arg value="-c"/>
                                    <arg value="find ${build.dir}/libs/ -name 'opencga-hadoop-shaded*' | wc -l | grep -q '^1$'"/>
                                </exec>

                                <chmod perm="u+x">
                                    <fileset dir="${build.dir}">
                                        <include name="**/*.sh"/>
                                        <exclude name="**/opencga-env.sh"/>
                                    </fileset>
                                </chmod>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>opencga-client</id>
                        <phase>install</phase>
                        <configuration>
                            <target>
                                <echo>Preparing 'opencga-client' folder</echo>
                                <exec executable="mkdir" failonerror="true">
                                    <arg value="${build.dir}/${opencga.client.dir}"/>
                                    <arg value="${build.dir}/${opencga.client.dir}/bin"/>
                                    <arg value="${build.dir}/${opencga.client.dir}/conf"/>
                                    <arg value="${build.dir}/${opencga.client.dir}/completion"/>
                                </exec>

                                <echo>Copying files to 'opencga-client' folder</echo>
                                <exec executable="cp" failonerror="true">
                                    <arg value="-r"/>
                                    <arg value="${build.dir}/libs"/>
                                    <arg value="${build.dir}/clients/python"/>
                                    <arg value="${build.dir}/clients/R"/>
                                    <arg value="${build.dir}/clients/javascript"/>
<!--                                    <arg value="${build.dir}/LICENSE"/>-->
<!--                                    <arg value="${build.dir}/README.md"/>-->
                                    <arg value="${build.dir}/${opencga.client.dir}"/>
                                </exec>

                                <exec executable="cp" failonerror="true">
                                    <arg value="${build.dir}/bin/opencga.sh"/>
                                    <!--<arg value="${build.dir}/bin/opencga-enterprise.sh"/>-->
                                    <arg value="${build.dir}/${opencga.client.dir}/bin"/>
                                </exec>

                                <exec executable="cp" failonerror="true">
                                    <arg value="${build.dir}/conf/configuration.yml"/>
                                    <arg value="${build.dir}/conf/client-configuration.yml"/>
                                    <arg value="${build.dir}/conf/enterprise-configuration.yml"/>
                                    <arg value="${build.dir}/${opencga.client.dir}/conf"/>
                                </exec>

                                <exec executable="cp" failonerror="true">
                                    <arg value="${build.dir}/misc/completion/opencga"/>
                                    <arg value="${build.dir}/misc/completion/README.md"/>
                                    <arg value="${build.dir}/${opencga.client.dir}/completion"/>
                                </exec>

                                <echo>Creating 'opencga-client' tar.gz file</echo>
                                <exec executable="tar" failonerror="true">
                                    <arg value="-C"/>
                                    <arg value="${build.dir}"/>
                                    <arg value="-czf"/>
                                    <arg value="${build.dir}/${opencga.client.dir}.tar.gz"/>
                                    <arg value="${opencga.client.dir}"/>
                                </exec>

                                <echo>Deleting temporary 'opencga-client' folder</echo>
                                <exec executable="rm" failonerror="true">
                                    <arg value="-rf"/>
                                    <arg value="${build.dir}/${opencga.client.dir}"/>
                                </exec>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>