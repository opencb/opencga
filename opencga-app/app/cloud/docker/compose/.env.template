# OpenCGA Local Deployment Configuration
# ========================================
# Copy to .env and customize, or let deploy.sh generate it automatically.
# Values shown are the defaults used by deploy.sh when not overridden.

# OpenCGA Docker image tag (auto-detected from pom.xml if not set)
#OPENCGA_VERSION=5.0.0-SNAPSHOT

# Docker image organization
OPENCGA_DOCKER_ORG=opencb

# Full Docker image reference (auto-computed from OPENCGA_DOCKER_ORG + OPENCGA_VERSION if not set)
# Override to use a custom or pre-built image, e.g.: myrepo/opencga-base:2.0.0
#OPENCGA_IMAGE=opencb/opencga-base:5.0.0-SNAPSHOT

# IVA Docker image (org/name separate from OpenCGA)
IVA_DOCKER_IMAGE=zettagenomics/iva-enterprise

# Admin password for OpenCGA (used for catalog install and admin operations)
OPENCGA_ADMIN_PASSWORD=adminOpencga2024.

# Organization to create after install
OPENCGA_ORG_ID=test

# Owner user for the organization
OPENCGA_OWNER_ID=test-user
OPENCGA_OWNER_NAME="Test User"
OPENCGA_OWNER_EMAIL=test@opencga.local
OPENCGA_OWNER_PASSWORD=testOpencga2024.

# MongoDB
MONGO_VERSION=6.0
MONGO_PORT=27017

# Solr
SOLR_VERSION=8.11
SOLR_PORT=8983

# OpenCGA REST port
OPENCGA_REST_PORT=9090

# IVA
IVA_VERSION=4.0.0
IVA_PORT=8080

# Memory settings
# Java heap for OpenCGA REST (container limit = heap * 1.3)
OPENCGA_REST_HEAP=500m
# Java heap for OpenCGA Master daemon process
OPENCGA_MASTER_HEAP=400m
# Java heap for child job processes spawned by Master (container limit = (master + job) * 1.3)
OPENCGA_JOB_HEAP=1g
# Container memory limits for infrastructure services
OPENCGA_MONGO_MEM=1g
OPENCGA_SOLR_MEM=1g

# Storage engine: mongodb (default) or hadoop (HBase + Phoenix)
# Set with: ./deploy.sh up --storage hadoop
#OPENCGA_STORAGE_ENGINE=mongodb
#OPENCGA_HBASE_HEAP=2g
#HBASE_MASTER_PORT=16010
#ZOOKEEPER_PORT=2181

# Docker socket (for job execution via Docker-in-Docker)
# Auto-detected by deploy.sh if not set.
# Rootless example: /run/user/1000/docker.sock
#DOCKER_SOCK=/var/run/docker.sock
